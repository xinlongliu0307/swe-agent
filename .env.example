# Copy to .env (untracked) and fill in.
# provider: "openai" (any OpenAI-compatible endpoint, e.g. Ollama) or "anthropic"
SWE_PROVIDER=openai
SWE_BASE_URL=http://localhost:11434/v1
SWE_MODEL=qwen2.5-coder:14b
SWE_API_KEY=
ANTHROPIC_API_KEY=
SWE_MAX_STEPS=30
# per model call: seconds before giving up, and how many retries (with backoff)
SWE_TIMEOUT_S=240
SWE_RETRIES=3
# optional sampling for single runs; npm run eval sets its own (see evals/run.ts)
SWE_TEMPERATURE=
SWE_SEED=

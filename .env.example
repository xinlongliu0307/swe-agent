# Copy to .env (untracked) and fill in.
# provider: "openai" (any OpenAI-compatible endpoint, e.g. Ollama) or "anthropic"
SWE_PROVIDER=openai
SWE_BASE_URL=http://localhost:11434/v1
SWE_MODEL=qwen3.6:27b
SWE_API_KEY=
ANTHROPIC_API_KEY=
SWE_MAX_STEPS=30
# per model call: seconds before giving up, and how many retries (with backoff)
SWE_TIMEOUT_S=240
SWE_RETRIES=3
# optional sampling for single runs; npm run eval sets its own (see evals/run.ts)
SWE_TEMPERATURE=
SWE_SEED=
# the project test command; the agent runs it itself before accepting finish (or pass -t)
SWE_TEST_CMD=
# cap on each model reply (default 2048); stops runaway generations
SWE_MAX_TOKENS=4096

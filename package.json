{
  "name": "swe-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal, dependency-free software engineering agent in TypeScript.",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "swe": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc -p .",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "eval": "node --disable-warning=ExperimentalWarning evals/run.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
